{
  "name": "axiom-pr",
  "version": "1.0.1",
  "description": "AI-powered pull request reviewer for Azure DevOps. Supports Codex CLI, Claude Code, OpenAI, and Anthropic. Includes CLI watcher with TUI.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "axiom-pr": "dist/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "cli": "npm run build && node dist/cli.mjs",
    "test": "node -e \"require('fs').rmSync('.test-dist', { recursive: true, force: true })\" && tsc -p tsconfig.test.json && node --test .test-dist/tests/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "azure-devops",
    "pull-request",
    "code-review",
    "ai",
    "codex",
    "openai",
    "claude",
    "anthropic",
    "pr-review",
    "devops",
    "automation",
    "tui",
    "cli"
  ],
  "author": "Enis Karriqi, Johan Bujari",
  "homepage": "https://github.com/JohanBujari/ai-code-reviewer",
  "bugs": {
    "url": "https://github.com/JohanBujari/ai-code-reviewer/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JohanBujari/ai-code-reviewer.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.0.0",
    "@ai-sdk/openai": "^1.0.0",
    "ai": "^4.0.0",
    "commander": "^12.0.0",
    "diff": "^8.0.3",
    "dotenv": "^16.0.0",
    "ink": "^5.0.0",
    "react": "^18.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/node": "^25.3.0",
    "@types/react": "^18.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
