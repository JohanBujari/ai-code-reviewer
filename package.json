{
  "name": "azure-devops-pr-reviewer",
  "version": "1.1.0",
  "description": "AI-powered pull request reviewer for Azure DevOps. Supports Azure OpenAI, OpenAI, and Claude. Includes CLI watcher with TUI.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "pr-agent": "./dist/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "azure-devops",
    "pull-request",
    "code-review",
    "ai",
    "openai",
    "claude",
    "anthropic",
    "pr-review",
    "devops",
    "automation",
    "tui",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.0.0",
    "@ai-sdk/azure": "^1.0.0",
    "@ai-sdk/openai": "^1.0.0",
    "ai": "^4.0.0",
    "commander": "^12.0.0",
    "diff": "^8.0.3",
    "dotenv": "^16.0.0",
    "ink": "^5.0.0",
    "react": "^18.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/node": "^25.3.0",
    "@types/react": "^18.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
