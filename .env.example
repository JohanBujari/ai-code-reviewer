# Azure DevOps Configuration
AZURE_DEVOPS_ORG=your-org
AZURE_DEVOPS_PAT=your-personal-access-token

# AI Provider: codex | claude | openai | anthropic
AI_PROVIDER=codex

# Codex CLI (if AI_PROVIDER=codex)
# Run `codex login` before using the CLI/TUI flow
# CODEX_MODEL=gpt-5.2
# CODEX_REASONING_EFFORT=medium

# Claude Code (if AI_PROVIDER=claude)
# Run `claude` and then `/login` before using the CLI/TUI flow
# CLAUDE_MODEL=sonnet
# CLAUDE_EFFORT=medium

# OpenAI API key (if AI_PROVIDER=openai)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5.2

# Repositories to watch (watch mode only, comma-separated: project/repoId/repoName)
WATCH_REPOS=MyProject/repo-guid-here/my-repo

# Anthropic (if AI_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5
