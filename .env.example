# Azure DevOps Configuration
AZURE_DEVOPS_ORG=your-org
AZURE_DEVOPS_PAT=your-personal-access-token

# Repositories to watch (comma-separated: project/repoId/repoName)
WATCH_REPOS=MyProject/repo-guid-here/my-repo

# AI Provider: openai | anthropic | azure-openai
AI_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# Anthropic (if AI_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Azure OpenAI (if AI_PROVIDER=azure-openai)
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_DEPLOYMENT=gpt-4o
# AZURE_OPENAI_API_VERSION=2024-02-01
